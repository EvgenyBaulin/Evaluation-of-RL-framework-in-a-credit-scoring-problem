\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Three-phase episode structure. The warm-up phase pre-fills the loan book before the agent begins acting. The interactive phase is the control horizon. Terminal settlement resolves all outstanding loans so the episode summary reflects full portfolio consequences.}}{15}{figure.caption.26}\protected@file@percent }
\newlabel{fig:en-episode-timeline}{{1}{15}{Three-phase episode structure. The warm-up phase pre-fills the loan book before the agent begins acting. The interactive phase is the control horizon. Terminal settlement resolves all outstanding loans so the episode summary reflects full portfolio consequences}{figure.caption.26}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.2}Weekly simulation logic}{15}{subsection.6.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Within-week simulation step. The nine steps are laid out in two columns (steps 1--5 on the left, steps 6--9 on the right) connected by the lower bridge. The left column covers market generation and cohort management, and the right column covers reward computation, observation assembly, and the terminal-settlement check. The orange path on the left marks the loop back from step~9 to step~1 at the start of the next week.}}{16}{figure.caption.27}\protected@file@percent }
\newlabel{fig:en-weekly-flowchart}{{2}{16}{Within-week simulation step. The nine steps are laid out in two columns (steps 1--5 on the left, steps 6--9 on the right) connected by the lower bridge. The left column covers market generation and cohort management, and the right column covers reward computation, observation assembly, and the terminal-settlement check. The orange path on the left marks the loop back from step~9 to step~1 at the start of the next week}{figure.caption.27}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Data Modelling and Simulation}{17}{subsection.6.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Single-loan lifecycle. An application arriving at week~$t$ is either rejected (score below threshold, no further tracking) or accepted. Accepted loans become outstanding and eventually resolve as repaid, defaulted, or prepaid. The repayment window of $L$ weeks creates the temporal credit-assignment lag that motivates this study.}}{17}{figure.caption.28}\protected@file@percent }
\newlabel{fig:en-loan-lifecycle}{{3}{17}{Single-loan lifecycle. An application arriving at week~$t$ is either rejected (score below threshold, no further tracking) or accepted. Accepted loans become outstanding and eventually resolve as repaid, defaulted, or prepaid. The repayment window of $L$ weeks creates the temporal credit-assignment lag that motivates this study}{figure.caption.28}{}}
\citation{herasymovych2019}
\citation{lessmann2015}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Delayed reward attribution. Each cohort bar represents loans accepted at a specific week (diamond marker) that remain outstanding for $L$ weeks before their outcome is realized (star marker). At any given week, profit and default signals arrive simultaneously from multiple overlapping cohorts originated in earlier weeks, making credit assignment non-trivial for the RL agent.}}{18}{figure.caption.29}\protected@file@percent }
\newlabel{fig:en-delayed-reward}{{4}{18}{Delayed reward attribution. Each cohort bar represents loans accepted at a specific week (diamond marker) that remain outstanding for $L$ weeks before their outcome is realized (star marker). At any given week, profit and default signals arrive simultaneously from multiple overlapping cohorts originated in earlier weeks, making credit assignment non-trivial for the RL agent}{figure.caption.29}{}}
